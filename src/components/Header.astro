---
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '../site.config';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/'
    ? path === '/' || path.startsWith('/posts/') || path.startsWith('/category/') || path.startsWith('/tags/')
    : path.startsWith(href);
---

<header class="wrap site-header">
  <a class="name" href="/">
    {SITE.title}
  </a>
  <nav aria-label="Main">
    <ul>
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <ThemeToggle />
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }

  .name {
    flex: 1;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
  }

  /* On phones: name and theme toggle on the first row, links below. */
  @media (max-width: 34rem) {
    .site-header {
      padding-bottom: 2.5rem;
    }

    nav {
      order: 3;
      width: 100%;
    }
  }

  ul {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
</style>
