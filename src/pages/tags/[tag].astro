---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugifyTag } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  for (const post of posts) for (const tag of post.data.tags) tags.set(slugifyTag(tag), tag);

  return [...tags].map(([slug, name]) => ({
    params: { tag: slug },
    props: { name, posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === slug)) },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={`Tagged ${name}`}>
  <h1>Tagged “{name}”</h1>
  <PostList posts={posts} />
  <p class="back">
    <a href="/">All writing</a>
  </p>
</Base>

<style>
  h1 {
    font-size: 1.4rem;
    margin: 0 0 2rem;
  }

  .back {
    margin-top: 2.5rem;
    font-size: 0.9rem;
  }
</style>
