---
// Layout for standalone Markdown pages such as src/pages/about.md.
import Base from './Base.astro';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article>
    <h1>{frontmatter.title}</h1>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  h1 {
    font-size: 1.75rem;
    margin: 0 0 1.75rem;
  }
</style>
