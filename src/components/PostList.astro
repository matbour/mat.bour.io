---
import { groupByYear, postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const groups = groupByYear(posts);
const fmt = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', timeZone: 'UTC' });
---

{posts.length === 0 ? (
  <p class="muted">Nothing here yet.</p>
) : (
  groups.map(([year, items]) => (
    <section class="year" aria-labelledby={`y${year}`}>
      <h2 id={`y${year}`}>{year}</h2>
      <ol>
        {items.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
            <a href={postUrl(post)}>
              {post.data.title}
              {post.data.draft && <span class="draft">draft</span>}
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))
)}

<style>
  .year + .year {
    margin-top: 2.25rem;
  }

  h2 {
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
    font-variant-numeric: lining-nums;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 4.25rem 1fr;
    gap: 0 0.75rem;
    align-items: baseline;
    padding: 0.3rem 0;
  }

  time {
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
  }

  a {
    color: var(--ink);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .draft {
    margin-left: 0.5em;
    font-size: 0.75rem;
    font-style: italic;
    color: var(--muted);
  }
</style>
