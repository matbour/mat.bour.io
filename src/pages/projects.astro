---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { getPosts } from '../lib/posts';

const projects = await Promise.all(
  (await getCollection('projects'))
    .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year)
    .map(async (entry) => ({ data: entry.data, Content: (await render(entry)).Content })),
);

// Only link to posts that are published in this build (drafts are dev-only).
const postIds = new Set((await getPosts()).map((p) => p.id));

const statusLabel = { active: 'Active', maintained: 'Maintained', archived: 'Archived' } as const;
---

<Base title="Projects" description="Things Mathieu Bour builds on his own time.">
  <h1>Projects</h1>
  <p class="lede muted">
    Things I build on my own time. For what I've built at work, see <a href="/experience/">experience</a>.
  </p>

  <ul class="entries">
    {projects.map(({ data, Content }) => (
      <Entry
        title={data.name}
        url={data.url}
        year={data.year}
        until={data.until}
        summary={data.summary}
        details={data.stack.join(', ') + (data.status !== 'active' ? `. ${statusLabel[data.status]}` : '')}
        post={data.post && postIds.has(data.post) ? data.post : undefined}
        repo={data.repo}
      >
        <Content />
      </Entry>
    ))}
  </ul>
</Base>

<style>
  h1 {
    font-size: 1.75rem;
    margin: 0 0 0.5rem;
  }

  .lede {
    margin: 0 0 2.5rem;
  }

  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
